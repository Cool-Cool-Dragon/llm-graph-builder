# ============================================
# 国内大模型 (LLM Graph Builder - China)
# ============================================
NEO4J_URI = "" # Neo4j 数据库连接地址
NEO4J_USERNAME = "" # Neo4J 数据库用户名
NEO4J_PASSWORD = "" # Neo4j 数据库密码
NEO4J_DATABASE = "" # Neo4j 数据库名

# ============================================
# CHINA LLM PROVIDERS (OpenAI-兼容 API)
# ============================================
# 所有国内 LLM 提供商使用统一的 OpenAI 兼容格式:
#   ChatOpenAI(api_key=api_key, base_url=api_endpoint, model=model_name, ...)
#
# 格式: model_name,base_url,api_key

# ---- 千问 (通义千问) via 阿里云 DashScope ----
# base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型: qwen-max, qwen-plus, qwen-turbo, qwen-long
LLM_MODEL_CONFIG_QWEN_MAX="qwen-max,https://dashscope.aliyuncs.com/compatible-mode/v1,dashscope_api_key_here"
LLM_MODEL_CONFIG_QWEN_PLUS="qwen-plus,https://dashscope.aliyuncs.com/compatible-mode/v1,dashscope_api_key_here"
LLM_MODEL_CONFIG_QWEN_TURBO="qwen-turbo,https://dashscope.aliyuncs.com/compatible-mode/v1,dashscope_api_key_here"
LLM_MODEL_CONFIG_QWEN_LONG="qwen-long,https://dashscope.aliyuncs.com/compatible-mode/v1,dashscope_api_key_here"

# ---- DeepSeek ----
# base_url: https://api.deepseek.com/v1
# 模型: deepseek-chat, deepseek-reasoner
LLM_MODEL_CONFIG_DEEPSEEK_CHAT="deepseek-chat,https://api.deepseek.com/v1,deepseek_api_key_here"
LLM_MODEL_CONFIG_DEEPSEEK_REASONER="deepseek-reasoner,https://api.deepseek.com/v1,deepseek_api_key_here"

# ---- 讯飞星火 iFlyTek Spark ----
# base_url: https://spark-api-open.xf-yun.com/v1
# 模型: generalv3.5 (v3.5), generalv4 (v4), general (lite)
LLM_MODEL_CONFIG_SPARK_MAX="generalv4,https://spark-api-open.xf-yun.com/v1,spark_api_key_here"
LLM_MODEL_CONFIG_SPARK_PLUS="generalv3.5,https://spark-api-open.xf-yun.com/v1,spark_api_key_here"
LLM_MODEL_CONFIG_SPARK_LITE="general,https://spark-api-open.xf-yun.com/v1,spark_api_key_here"

# ---- 预留配置 (其他国内模型) ----
# 格式: model_name,base_url,api_key
# LLM_MODEL_CONFIG_XXX="model_name,https://api_endpoint,api_key"


# ============================================
# CHINA EMBEDDING PROVIDERS
# ============================================
# 通义文本嵌入 - 使用 OpenAI-兼容 API
# 格式: base_url,api_key
QWEN_EMBEDDING_MODEL_KEY="https://dashscope.aliyuncs.com/compatible-mode/v1,dashscope_api_key_here"

# 腾讯语义嵌入 - 使用 OpenAI-兼容 API
# 格式: base_url,api_key
TENCENT_EMBEDDING_MODEL_KEY="https://api.tencentcloudapi.com/v1,tencent_api_key_here"

EMBEDDING_PROVIDER="" # 可选: "sentence-transformer" / "qwen" / "tencent"

# --- 本地 sentence-transformer 模型 (无需联网) ---
# 模型		维度	特点
# all-MiniLM-L6-v2		384	最轻量,首次启动自动下载
# all-MiniLM-L12-v2		384	L6 的加深版,精度略好
# paraphrase-multilingual-mpnet-v2	768	多语言中英效果平衡,推荐通用场景
# bge-large-zh			1024	BGE 系列中文最强,精度最好(模型较大)
# bge-base-zh			768	BGE 系列中文,体积与精度折中
# bge-m3			1024	BGE 多语言多功能,支持短文本和长文本

# 推荐搭配:
# 	快速测试: EMBEDDING_MODEL="all-MiniLM-L6-v2"
# 	中英混合: EMBEDDING_MODEL="paraphrase-multilingual-mpnet-v2"
# 	中文优先: EMBEDDING_MODEL="bge-large-zh"
EMBEDDING_MODEL="all-MiniLM-L6-v2"
ENTITY_EMBEDDING="" # 可选: "True"/"False" - 是否创建实体嵌入(用于 entity vector 模式)

TRACK_USER_USAGE="true" # 是否开启 token 使用追踪
DAILY_TOKENS_LIMIT="250000" # 每日 token 上限 (TRACK_USER_USAGE 为 true 时必填)
MONTHLY_TOKENS_LIMIT="1000000" # 每月 token 上限 (TRACK_USER_USAGE 为 true 时必填)
TOKEN_TRACKER_DB_URI=""  # token 追踪数据库地址 (TRACK_USER_USAGE 为 true 时必填)
TOKEN_TRACKER_DB_USERNAME="" # token 追踪数据库用户名
TOKEN_TRACKER_DB_PASSWORD="" # token 追踪数据库密码
TOKEN_TRACKER_DB_DATABASE="" # token 追踪数据库名
AUTHENTICATION_REQUIRED="" # 可选: "True"/"False" - 是否启用 API 访问认证
AUTH0_DOMAIN="" # AUTHENTICATION_REQUIRED 为 true 时必填
AUTH0_AUDIENCE="" # 可选: Auth0 API audience
ALLOWED_FRONTEND_ORIGINS="*" # 可选: CORS 允许的源